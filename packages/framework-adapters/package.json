{
  "name": "@css-archaeology/framework-adapters",
  "version": "0.1.0",
  "description": "Framework adapters (HTML, React, Next.js, CSS Modules, Tailwind CSS) that extract CSS references for CSS Archaeology.",
  "license": "MIT",
  "author": "Workfonic Labs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisarena-sketch/CSS-Archealogy.git",
    "directory": "packages/framework-adapters"
  },
  "homepage": "https://github.com/abhisarena-sketch/CSS-Archealogy#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@css-archaeology/core": "0.1.0",
    "htmlparser2": "^10.0.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/abhisarena-sketch/CSS-Archealogy/issues"
  }
}
